{
  "name": "saltbee",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dev:app": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env SALTBEE_DEV_URL=http://localhost:5173 electron electron/main.cjs\"",
    "start": "npm run build && electron electron/main.cjs",
    "dist:win": "npm run icons && npm run build && electron-builder --win --x64",
    "dist:win:portable": "npm run icons && npm run build && electron-builder --win portable --x64",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist": "npm run icons && npm run build && electron-builder",
    "icons": "node scripts/make-icons.cjs",
    "smoke": "node scripts/smoke-render.cjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "^1.40.0",
    "music-metadata": "^11.15.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^28.0.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "wait-on": "^8.0.1"
  },
  "productName": "SaltBee",
  "description": "SaltBee — MusicBee library × AIMP engine × Salt Player design. The ultimate desktop music player.",
  "author": {
    "name": "SaltBee",
    "email": "hi@saltbee.app"
  },
  "license": "MIT",
  "main": "electron/main.cjs"
}
